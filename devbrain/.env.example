# Copia este archivo como devbrain/.env y completa los valores. Nunca subas .env a GitHub.

# --- Slack (api.slack.com/apps) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Canal donde avisar cuando se genere un post-mortem al archivar (ID, ej. C0123456). Opcional.
NOTIFY_CHANNEL=
# Solo los canales con este prefijo generan post-mortem al archivarse.
INCIDENT_PREFIX=inc-

# --- GitHub (token fine-grained con Contents y Pull requests: lectura y escritura) ---
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=Rayo2995/devcore-conocimiento
GIT_BRANCH=main

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# --- Ajustes opcionales ---
SYNC_MINUTES=5
TOP_K=4
MIN_SCORE=0.35
INCIDENTS_DIR=03-incidentes
TIMEZONE=America/Bogota
